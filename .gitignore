# No game content, proprietary binaries, or local execution artifacts.
*.exe
*.dll
*.rpf
*.xvd
*.xvc
*.pak
*.torrent
*.iso
*.img
*.msix
*.msi
*.cab
*.pdb
*.dmp
*.mdmp
*.core
*.raw
*.bin
*.zip
*.7z
*.rar
*.log
*.trace
*.etl

# Never commit secrets, local paths or unreviewed captures.
.env
.env.*
*.pem
*.pfx
*.key
*.token
*.secret
**/secrets/
**/private/
**/captures/
**/dumps/
**/logs/
**/scratch/
**/game/
**/game-files/
**/original-binaries/

# Build and editor outputs
build/
out/
dist/
.vs/
.vscode/
.idea/
__pycache__/
.pytest_cache/
.venv/
node_modules/
.DS_Store

# NOTE: .gitignore is not a security boundary; review every commit and git diff.
